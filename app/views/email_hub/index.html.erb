<div style="display:grid;grid-template-columns:340px 1fr;gap:16px"
     data-controller="email-hub"
     data-email-hub-candidates-value="<%= @candidates_json.to_json %>"
     data-email-hub-templates-value="<%= @email_templates.to_json %>"
     data-email-hub-current-user-name-value="<%= current_user.name %>"
     data-email-hub-default-company-value="Spritle Software">
  <!-- LEFT: Compose -->
  <div class="flex flex-col gap-4">
    <div class="card">
      <div class="card-header">
        Compose Email
      </div>

      <div class="card-body flex flex-col gap-3">
        <%= form_with url: send_email_hubs_path, method: :post do |f| %>
          <div class="form-group" style="gap: 0 !important; margin-bottom: 20px;">
            <div class="label">Template</div>
            <%= select_tag :template_name,
                        options_for_select(@email_templates.map { |t| [t[:name], t[:id]] }),
                        include_blank: "— Select a template —",
                        class: "select",
                        id: "em-template",
                        data: { email_hub_target: "template", action: "change->email-hub#loadTemplate" } %>
          </div>
          <div class="form-group" style="gap: 0 !important; margin-bottom: 20px;">
            <div class="label">Candidate</div>
            <%= select_tag :candidate_id,
                        options_from_collection_for_select(@candidates, :id, :name),
                        prompt: "Select Candidate",
                        class: "select",
                        id: "em-candidate",
                        data: { email_hub_target: "candidate", action: "change->email-hub#selectCandidate" } %>
          </div>
          <div class="form-group" style="gap: 0 !important; margin-bottom: 20px;">
            <div class="label">To Email</div>
            <%= text_field_tag :to_email, nil,
                            placeholder: "To Email",
                            required: true,
                            class: "input",
                            id: "em-to",
                            data: { email_hub_target: "toEmail" } %>
          </div>
          <div class="form-group" style="gap: 0 !important; margin-bottom: 20px;">
            <div class="label">CC</div>
            <%= text_field_tag :cc, nil,
                            placeholder: "CC (comma-separated)",
                            class: "input",
                            id: "em-cc",
                            data: { email_hub_target: "cc" } %>
          </div>
          <div class="form-group" style="gap: 0 !important; margin-bottom: 20px;">
            <div class="label">Subject</div>
            <%= text_field_tag :subject, nil,
                            placeholder: "Subject",
                            required: true,
                            class: "input",
                            id: "em-subject",
                            data: { email_hub_target: "subject" } %>
          </div>
          <div class="form-group" style="gap: 0 !important; margin-bottom: 20px;">
            <div class="label">Body</div>
            <%= text_area_tag :body, nil,
                            rows: 10,
                            required: true,
                            class: "textarea",
                            id: "em-body",
                            data: { email_hub_target: "body" } %>
          </div>
          <div class="form-group" style="gap: 0 !important;">
            <%= submit_tag "Send Email",
                        class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="flex flex-col gap-4">
    <div class="card">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between">
        <span>Email Log</span>
        <%= button_to "Clear Log", email_hub_clear_log_path,
                    method: :delete,
                    class: "btn btn-sm",
                    data: { turbo_confirm: "Clear all email logs?" } %>
      </div>

      <div class="card-body">
        <% if @email_logs.empty? %>
          <div style="color:var(--text3);font-size:13px">No emails sent yet.</div>
        <% end %>
        <% @email_logs.each do |log| %>
          <% status_color = { "pending" => "amber", "sent" => "green", "failed" => "red" }[log.status] || "gray" %>
          <div class="email-log-item">
            <strong><%= log.subject %></strong>
            <span class="badge badge-<%= status_color %>"><%= log.status %></span>
            <div>
              To: <%= log.recipient_email %><% if log.cc_email.present? %> · CC: <%= log.cc_email %><% end %>
            </div>
            <% if log.status == "failed" && log.error_message.present? %>
              <div style="color:var(--danger, #c0392b);font-size:12px"><%= log.error_message %></div>
            <% end %>
            <div>
              <%= time_ago_in_words(log.created_at) %> ago
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        Quick Templates Preview
      </div>

      <div class="card-body">
        <% @email_templates.each do |t| %>
          <div style="background:var(--bg3);border:1px solid var(--border);border-radius:var(--r-sm);padding:12px;cursor:pointer"
              data-action="click->email-hub#quickLoad"
              data-email-hub-id-param="<%= t[:id] %>"
              onmouseover="this.style.borderColor='var(--accent)'"
              onmouseout="this.style.borderColor='var(--border)'">

            <div style="font-weight:500;font-size:13px;margin-bottom:3px">
              <%= t[:name] %>
            </div>

            <div style="font-size:11px;color:var(--text3)">
              <%= t[:subject] %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
