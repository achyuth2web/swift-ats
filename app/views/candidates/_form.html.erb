<%= form_with model: candidate, html: { class: "flex flex-col gap-3" } do |f| %>
  <% if candidate.errors.any? %><div class="flash-alert"><%= candidate.errors.full_messages.first %></div><% end %>
  <div class="input-row">
    <div class="form-group"><label class="label">Full Name *</label><%= f.text_field :name, class: "input" %></div>
    <div class="form-group"><label class="label">Email</label><%= f.email_field :email, class: "input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Phone</label><%= f.text_field :phone, class: "input" %></div>
    <div class="form-group"><label class="label">Role / Title</label><%= f.text_field :role, class: "input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Department</label><%= f.select :department, Candidate::DEPARTMENTS, { include_blank: "Select" }, class: "select" %></div>
    <div class="form-group"><label class="label">Designation</label><%= f.text_field :designation, class: "input" %></div>
  </div>
  <div class="form-group"><label class="label">Skills (comma-separated)</label><%= f.text_field :skills_list, class: "input", placeholder: "React, TypeScript, Node.js" %></div>
  <div class="input-row-3">
    <div class="form-group"><label class="label">Experience (years)</label><%= f.number_field :experience_years, class: "input", min: 0 %></div>
    <div class="form-group"><label class="label">Status</label><%= f.select :status, Candidate::STATUSES, {}, class: "select" %></div>
    <div class="form-group"><label class="label">Score (0-100)</label><%= f.number_field :score, class: "input", min: 0, max: 100 %></div>
  </div>
  <div class="input-row-3">
    <div class="form-group"><label class="label">Current CTC (LPA)</label><%= f.text_field :ctc_current, class: "input" %></div>
    <div class="form-group"><label class="label">Expected CTC (LPA)</label><%= f.text_field :ctc_expected, class: "input" %></div>
    <div class="form-group"><label class="label">Notice Period (days)</label><%= f.text_field :notice_period, class: "input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Source</label><%= f.select :source, Candidate::SOURCES, { include_blank: "Select" }, class: "select" %></div>
    <div class="form-group"><label class="label">Linked Job</label><%= f.select :job_id, @jobs.map{|j|[j.title,j.id]}, { include_blank: "None" }, class: "select" %></div>
  </div>
  <% if defined?(@recruiters) && @recruiters %>
    <div class="form-group"><label class="label">Recruiter</label><%= f.select :recruiter_id, @recruiters.map{|r|[r.name,r.id]}, { include_blank: "None" }, class: "select" %></div>
  <% end %>
  <div class="form-group"><label class="label">Notes</label><%= f.text_area :notes, class: "textarea" %></div>
  <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:8px">
    <%= link_to "Cancel", candidates_path, class: "btn btn-ghost" %>
    <%= f.submit candidate.persisted? ? "Update Candidate" : "Add Candidate", class: "btn btn-primary" %>
  </div>
<% end %>
