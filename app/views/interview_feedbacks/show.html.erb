<div class="card" style="margin-bottom:16px">
  <div class="card-header"><span class="fw-600">Interview Details</span></div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item"><div class="detail-label">Candidate</div><div class="detail-value"><%= @interview.candidate.name %></div></div>
      <% if @interview.candidate.job %>
        <div class="detail-item"><div class="detail-label">Job / Position</div><div class="detail-value"><%= @interview.candidate.job.title %></div></div>
      <% end %>
      <div class="detail-item"><div class="detail-label">Interview Type</div><div class="detail-value"><%= @interview.round_name %></div></div>
      <div class="detail-item"><div class="detail-label">Date &amp; Time</div><div class="detail-value"><%= @interview.scheduled_display %></div></div>
      <div class="detail-item"><div class="detail-label">Interviewer</div><div class="detail-value"><%= @interview.interviewer.presence || "—" %></div></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><span class="fw-600">Submit Feedback</span></div>
  <div class="card-body">
    <%= form_with model: @interview, url: update_interview_feedback_path(@interview.feedback_token), method: :patch, html: { class: "flex flex-col gap-3" } do |f| %>
      <% if @interview.errors.any? %><div class="flash-alert"><%= @interview.errors.full_messages.first %></div><% end %>
      <div class="input-row">
        <div class="form-group"><label class="label">Interview Status</label><%= f.select :status, Interview::STATUSES, {}, class: "select" %></div>
        <div class="form-group"><label class="label">Interview Outcome</label><%= f.select :outcome, Interview::OUTCOMES, { include_blank: "Select outcome" }, class: "select" %></div>
      </div>
      <div class="form-group"><label class="label">Rating (1–5)</label>
        <%= f.select :rating, [[1,"★"],[2,"★★"],[3,"★★★"],[4,"★★★★"],[5,"★★★★★"]].map{|v,l|[l,v]}, { include_blank: "No rating" }, class: "select", style: "max-width:200px" %>
      </div>
      <div class="form-group"><label class="label">Feedback / Comments</label><%= f.text_area :feedback, class: "textarea" %></div>
      <div style="display:flex;justify-content:flex-end;padding-top:8px">
        <%= f.submit "Submit Feedback", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
