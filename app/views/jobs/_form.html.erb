<%= form_with model: job, html: { class: "flex flex-col gap-3" } do |f| %>
  <% if job.errors.any? %><div class="flash-alert"><%= job.errors.full_messages.first %></div><% end %>
  <div class="input-row">
    <div class="form-group"><label class="label">Job Title *</label><%= f.text_field :title, class: "input", placeholder: "e.g. Senior React Developer" %></div>
    <div class="form-group"><label class="label">Company</label><%= f.text_field :company, class: "input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Department</label><%= f.select :department, Job::DEPARTMENTS, { include_blank: "Select" }, class: "select" %></div>
    <div class="form-group"><label class="label">Hiring Manager</label><%= f.text_field :hiring_manager, class: "input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Position Type</label><%= f.select :position_type, Job::POSITION_TYPES, {}, class: "select" %></div>
    <div class="form-group" id="replace-grp" style="<%= job.position_type=='Replacement' ? '' : 'display:none' %>">
      <label class="label">Replacing Employee</label><%= f.text_field :replacing_employee, class: "input" %>
    </div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Status</label><%= f.select :status, Job::STATUSES, {}, class: "select" %></div>
    <div class="form-group"><label class="label">Open Date</label><%= f.date_field :open_date, class: "input" %></div>
  </div>
  <div class="form-group" id="closing-notes-grp" style="<%= job.status=='Closed' ? '' : 'display:none' %>"><label class="label">Closing Notes</label><%= f.text_area :closing_notes, class: "textarea" %></div>
  <div class="form-group" id="onhold-notes-grp" style="<%= job.status=='On-Hold' ? '' : 'display:none' %>"><label class="label">On Hold Notes</label><%= f.text_area :onhold_notes, class: "textarea" %></div>
  <div class="input-row">
    <div class="form-group"><label class="label">Openings</label><%= f.number_field :openings, class: "input", min: 1, value: job.openings||1 %></div>
    <div class="form-group"><label class="label">Experience (years)</label><%= f.text_field :experience_years, class: "input" %></div>
  </div>
  <div id="opening-details-wrapper">
    <h4>Opening Details</h4>

    <table class="table">
      <thead>
        <tr>
          <th>#</th>
          <th>Closed Date</th>
          <th>Onboarded Date</th>
          <th></th>
        </tr>
      </thead>

      <tbody id="opening-details-body">
        <%= f.fields_for :job_openings do |of| %>
          <tr>
            <td>
              <%= of.hidden_field :sequence_no, class: "sequence-no" %>
              <span class="row-number"><%= of.object.sequence_no %></span>
            </td>

            <td>
              <%= of.date_field :closed_date, class: "input" %>
            </td>

            <td>
              <%= of.date_field :onboarded_date, class: "input" %>
            </td>
            <td>
              <button type="button" class="btn btn-ghost btn-sm remove-opening-row">Remove</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="form-group"><label class="label">Skills (comma-separated)</label><%= f.text_field :skills_list, class: "input", placeholder: "React, TypeScript, Node.js" %></div>
  <div class="input-row">
    <div class="form-group"><label class="label">Job Type</label><%= f.select :job_type, Job::JOB_TYPES, {}, class: "select" %></div>
    <div class="form-group" id="ctc-grp" style="<%= job.job_type != 'Full-Time' ? 'display:none' : '' %>"><label class="label">CTC Budget (LPA)</label><%= f.text_field :ctc_budget, class: "input", placeholder: "28" %></div>
    <div class="form-group" id="stipend-grp" style="<%= job.job_type == 'Full-Time' ? 'display:none' : '' %>">
      <label class="label">Stipend</label><%= f.text_field :stipend, class: "input" %>
    </div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Naukri URL</label><%= f.text_field :naukri_url, class: "input", placeholder: "https://naukri.com/..." %></div>
    <div class="form-group"><label class="label">Interview Type</label><%= f.text_field :interview_type, class: "input" %></div>
  </div>
  <div class="form-group"><label class="label">Description</label><%= f.text_area :description, class: "textarea" %></div>
  <% if defined?(recruiters) && recruiters&.any? %>
    <div class="form-group"><label class="label">Assign Recruiters</label>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <% recruiters.each do |r| %>
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text2);cursor:pointer">
            <input type="checkbox" name="job[recruiter_ids][]" value="<%= r.id %>" <%= job.recruiters.include?(r) ? "checked" : "" %> style="accent-color:var(--accent)"> <%= r.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
  <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:8px">
    <%= link_to "Cancel", jobs_path, class: "btn btn-ghost" %>
    <%= f.submit job.persisted? ? "Update Job" : "Create Job", class: "btn btn-primary" %>
  </div>
<% end %>
<script>
document.addEventListener("turbo:load", function() {
  const positionType = document.querySelector('select[name="job[position_type]"]');
  const jobType = document.querySelector('select[name="job[job_type]"]');
  const jobStatus = document.querySelector('select[name="job[status]"]');

  positionType?.addEventListener("change", function() {
    document.getElementById("replace-grp").style.display =
      this.value === "Replacement" ? "" : "none";
  });

  jobStatus?.addEventListener("change", function() {
    document.getElementById("closing-notes-grp").style.display =
      this.value === "Closed" ? "" : "none";
    document.getElementById("onhold-notes-grp").style.display =
      this.value === "On-Hold" ? "" : "none";

    if (this.value == "Closed") {
      document.getElementById("job_onhold_notes").value = "";
    } else if (this.value == "On-Hold") {
      document.getElementById("job_closing_notes").value = "";
    }
  });

  jobType?.addEventListener("change", function() {
    document.getElementById("stipend-grp").style.display =
      this.value === "Full-Time" ? "none" : "";
    document.getElementById("ctc-grp").style.display =
      this.value !== "Full-Time" ? "none" : "";
  });

  // Set initial visibility on page load
  if (positionType) {
    document.getElementById("replace-grp").style.display =
      positionType.value === "Replacement" ? "" : "none";
  }

  if (jobType) {
    document.getElementById("stipend-grp").style.display =
      jobType.value === "Full-Time" ? "none" : "";
    document.getElementById("ctc-grp").style.display =
      jobType.value !== "Full-Time" ? "none" : "";
  }
});
</script>
<script>
document.addEventListener("turbo:load", function() {
  const openingsInput = document.querySelector('input[name="job[openings]"]');
  const tbody = document.getElementById("opening-details-body");

  if (!openingsInput || !tbody) return;

  function syncRows() {
    const openings = parseInt(openingsInput.value || 0);
    const currentRows = tbody.querySelectorAll("tr").length;

    // Add rows
    for (let i = currentRows + 1; i <= openings; i++) {
      tbody.insertAdjacentHTML("beforeend", `
        <tr>
          <td>
            <input type="hidden"
              class="sequence-no"
              name="job[job_openings_attributes][${i-1}][sequence_no]"
              value="${i}">
            <span class="row-number">${i}</span>
          </td>

          <td>
            <input type="date"
              class="input"
              name="job[job_openings_attributes][${i-1}][closed_date]">
          </td>

          <td>
            <input type="date"
              class="input"
              name="job[job_openings_attributes][${i-1}][onboarded_date]">
          </td>
          <td>
            <button type="button" class="btn btn-ghost btn-sm remove-opening-row">Remove</button>
          </td>
        </tr>
      `);
    }

    // Remove extra rows
    while (tbody.querySelectorAll("tr").length > openings) {
      tbody.lastElementChild.remove();
    }
  }

  function visibleRows() {
    return Array.from(tbody.querySelectorAll("tr")).filter(row => row.style.display !== "none");
  }

  function renumberRows() {
    visibleRows().forEach((row, index) => {
      const seq = index + 1;
      const seqField = row.querySelector(".sequence-no");
      if (seqField) seqField.value = seq;
      const rowNumber = row.querySelector(".row-number");
      if (rowNumber) rowNumber.textContent = seq;
    });
  }

  tbody.addEventListener("click", function(e) {
    const btn = e.target.closest(".remove-opening-row");
    if (!btn) return;

    const row = btn.closest("tr");
    const idField = row.querySelector('input[name$="[id]"]');

    if (idField) {
      let destroyField = row.querySelector('input[name$="[_destroy]"]');
      if (!destroyField) {
        destroyField = document.createElement("input");
        destroyField.type = "hidden";
        destroyField.name = idField.name.replace(/\[id\]$/, "[_destroy]");
        row.appendChild(destroyField);
      }
      destroyField.value = "1";
      row.style.display = "none";
    } else {
      row.remove();
    }

    renumberRows();
    openingsInput.value = visibleRows().length;
  });

  openingsInput.addEventListener("change", syncRows);
  syncRows();
});
</script>