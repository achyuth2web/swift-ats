<%= form_with model: user, html:{class:"flex flex-col gap-3"} do |f| %>
  <% if user.errors.any? %><div class="flash-alert"><%= user.errors.full_messages.first %></div><% end %>
  <div class="input-row">
    <div class="form-group"><label class="label">Full Name *</label><%= f.text_field :name, class:"input" %></div>
    <div class="form-group"><label class="label">Email *</label><%= f.email_field :email, class:"input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Role</label><%= f.select :role, User::ROLES.map{|r|[r.capitalize,r]},{},class:"select" %></div>
    <div class="form-group"><label class="label">Status</label><%= f.select :active, [["Active",true],["Disabled",false]],{},class:"select" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label"><%= user.persisted? ? "New Password (blank = keep)" : "Password *" %></label><%= f.password_field :password, class:"input" %></div>
    <div class="form-group"><label class="label">Confirm Password</label><%= f.password_field :password_confirmation, class:"input" %></div>
  </div>
  <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:8px">
    <%= link_to "Cancel", users_path, class:"btn btn-ghost" %>
    <%= f.submit user.persisted? ? "Update User" : "Create User", class:"btn btn-primary" %>
  </div>
<% end %>
