<div style="text-align:center;margin-bottom:36px">
  <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:12px">
    <div style="width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#7c6aff,#a594ff);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(124,106,255,0.35)">
      <svg width="28" height="28" viewBox="0 0 28 28"><text x="5" y="22" font-family="Syne,sans-serif" font-weight="800" font-size="22" fill="white">S</text></svg>
    </div>
    <div style="text-align:left">
      <div style="font-family:'Syne',sans-serif;font-size:26px;font-weight:800;letter-spacing:-0.5px">Swift<span style="color:#a594ff">ATS</span></div>
      <div style="color:#50506a;font-size:11px;letter-spacing:0.06em;text-transform:uppercase">by Spritle Software</div>
    </div>
  </div>
</div>
<% if alert.present?  %><div class="flash-alert"><%= alert %></div><% end %>
<% if notice.present? %><div class="flash-notice"><%= notice %></div><% end %>
<div style="font-family:'Syne',sans-serif;font-size:19px;font-weight:700;margin-bottom:22px">Welcome back</div>
<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div style="display:flex;flex-direction:column;gap:14px">
    <div>
      <label class="label">Email address</label>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", placeholder: "Enter your email" %>
    </div>
    <div>
      <label class="label">Password</label>
      <%= f.password_field :password, autocomplete: "current-password", class: "input", placeholder: "••••••••" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:#8888a8;cursor:pointer">
        <%= f.check_box :remember_me, style: "accent-color:#7c6aff;width:14px;height:14px" %> Remember me
      </label>
    <% end %>
    <%= f.submit "Sign in to Swift ATS", class: "btn-sign-in" %>
  </div>
<% end %>
<div style="margin-top:24px;padding:16px;background:#15151f;border:1px solid rgba(255,255,255,0.07);border-radius:8px;font-size:12px;color:#8888a8">
  <div style="font-weight:600;color:#eeeef5;margin-bottom:8px">Demo Credentials</div>
  <div style="margin-bottom:4px">Admin: <span style="color:#a594ff">admin@swiftats.com</span> / <span style="color:#a594ff">admin123</span></div>
  <div>Recruiter: <span style="color:#a594ff">recruiter@swiftats.com</span> / <span style="color:#a594ff">recruiter123</span></div>
</div>
