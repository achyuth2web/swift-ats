<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — Swift ATS</title>
  <%= csrf_meta_tags %>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#08080e;--bg2:#0f0f18;--bg3:#15151f;--bg4:#1c1c28;--border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);--text:#eeeef5;--text2:#8888a8;--text3:#50506a;--accent:#7c6aff;--accent2:#a594ff;--accent-glow:rgba(124,106,255,0.14);--red:#ff4f72;--red-bg:rgba(255,79,114,0.09);--green:#22d3a0;--r-sm:6px;}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;}
    h1,h2,h3{font-family:'Syne',sans-serif;}
    #login-page{height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);background-image:radial-gradient(ellipse 70% 50% at 50% -10%,rgba(124,106,255,0.12) 0%,transparent 70%);}
    .login-box{width:420px;padding:48px;background:var(--bg2);border:1px solid var(--border);border-radius:20px;box-shadow:0 40px 120px rgba(0,0,0,0.7);}
    .label{font-size:12px;color:var(--text2);margin-bottom:5px;font-weight:500;display:block;}
    .input{width:100%;padding:9px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--r-sm);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;outline:none;transition:border-color 0.15s;}
    .input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,106,255,0.1);}
    .input::placeholder{color:var(--text3);}
    .btn-sign-in{display:flex;align-items:center;justify-content:center;width:100%;padding:12px;background:var(--accent);color:#fff;border:none;border-radius:var(--r-sm);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:background 0.15s;margin-top:6px;}
    .btn-sign-in:hover{background:var(--accent2);}
    .flash-alert{background:var(--red-bg);border:1px solid rgba(255,79,114,0.25);color:var(--red);padding:10px 14px;border-radius:var(--r-sm);font-size:13px;margin-bottom:16px;}
    .flash-notice{background:rgba(34,211,160,0.09);border:1px solid rgba(34,211,160,0.25);color:var(--green);padding:10px 14px;border-radius:var(--r-sm);font-size:13px;margin-bottom:16px;}
  </style>
</head>
<body>
<div id="login-page">
  <div class="login-box"><%= yield %></div>
</div>
</body>
</html>
