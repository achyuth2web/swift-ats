<!-- app/views/errors/not_found.html.erb -->

<div class="card" style="max-width:600px;margin:80px auto;text-align:center">
  <div class="card-body">
    <h1 style="font-size:72px;margin:0">404</h1>

    <h2>Page Not Found</h2>

    <p style="color:var(--text3)">
      The page you're trying to access does not exist
      or you don't have permission to view it.
    </p>

    <%= link_to "Back to Home",
    home_path_for(current_user),
    class: "btn btn-primary" %>
  </div>
</div>