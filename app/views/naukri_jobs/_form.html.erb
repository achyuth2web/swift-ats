<%= form_with model: naukri_job do |f| %>

  <div class="form-group">
    <label class="label">
      Job Title
    </label>

    <%= f.text_field :title,
        class: "input" %>
  </div>

  <div class="form-group pt-3">
    <label class="label">
      Location
    </label>

    <%= f.text_field :location,
        class: "input" %>
  </div>

  <div class="form-group pt-3">
    <label class="label">
      Job ID on Naukri
    </label>

    <%= f.text_field :external_id,
        class: "input" %>
  </div>

  <div class="form-group pt-3">
    <label class="label">
      Posted Date
    </label>

    <%= f.date_field :posted_on,
        class: "input" %>
  </div>

  <div class="form-group pt-3">
    <label class="label">
      Naukri Job URL
    </label>

    <%= f.url_field :url,
        class: "input" %>
  </div>

  <div class="form-group pt-3">
    <label class="label">
      Link Requisition
    </label>

    <%= f.collection_select(
          :job_id,
          Job.order(:title),
          :id,
          :title,
          { include_blank: true },
          { class: "select" }
        ) %>
  </div>

  <div class="form-group pt-3">
    <label class="label">
      Notes
    </label>

    <%= f.text_area :notes,
        rows: 3,
        class: "textarea" %>
  </div>

  <div style="margin-top:16px">
  <%= f.submit(
        naukri_job.persisted? ? "Update Job" : "Save Job",
        class: "btn btn-orange w-full"
      ) %>
  </div>

<% end %>