<%= form_with model: interview, html:{class:"flex flex-col gap-3"} do |f| %>
  <% if interview.errors.any? %><div class="flash-alert"><%= interview.errors.full_messages.first %></div><% end %>
  <div class="form-group"><label class="label">Candidate *</label>
    <%= f.select :candidate_id, @candidates.map{|c|[c.name+" — "+c.role.to_s,c.id]},{include_blank:"Select candidate"},class:"select" %>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Round Name *</label>
      <%= f.select :round_name, ["Screening","Technical 1","Technical 2","HR Round","Final Round","Managerial"],{include_blank:"Select round"},class:"select" %>
    </div>
    <div class="form-group"><label class="label">Round Number</label><%= f.number_field :round_number, class:"input", min:1, value: interview.round_number||1 %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Interviewer</label><%= f.text_field :interviewer, class:"input" %></div>
    <div class="form-group"><label class="label">Scheduled At</label><%= f.datetime_local_field :scheduled_at, class:"input" %></div>
  </div>
  <div class="input-row">
    <div class="form-group"><label class="label">Status</label><%= f.select :status, Interview::STATUSES, {}, class:"select" %></div>
    <div class="form-group"><label class="label">Outcome</label><%= f.select :outcome, Interview::OUTCOMES, {include_blank:"Pending"}, class:"select" %></div>
  </div>
  <div class="form-group"><label class="label">Rating (1–5)</label>
    <%= f.select :rating, [[1,"★"],[2,"★★"],[3,"★★★"],[4,"★★★★"],[5,"★★★★★"]].map{|v,l|[l,v]},{include_blank:"No rating"},class:"select",style:"max-width:200px" %>
  </div>
  <div class="form-group"><label class="label">Feedback</label><%= f.text_area :feedback, class:"textarea" %></div>
  <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:8px">
    <%= link_to "Cancel", interviews_path, class:"btn btn-ghost" %>
    <%= f.submit interview.persisted? ? "Update Interview" : "Schedule Interview", class:"btn btn-primary" %>
  </div>
<% end %>
